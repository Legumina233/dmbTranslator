{
  "manifest_version": 3,
  "name": "dmb M4 prefetch probe",
  "version": "0.2.0",
  "description": "M4 预取诊断探针（独立扩展，不碰正式扩展源码）：读正式扩展挂在页面 DOM 上的 data-m5-chain 遥测，popup 里看链路状态 + 变化时间线。测完直接移除本扩展。",
  "minimum_chrome_version": "111",
  "permissions": [],
  "host_permissions": [
    "*://*.exhentai.org/*",
    "*://*.e-hentai.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.exhentai.org/*", "*://*.e-hentai.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
